# Update these with your Supabase details from your project settings > API
# https://app.supabase.com/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=your-project-url
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_OR_ANON_KEY=your-anon-key

# Server-only. Prefer a current sb_secret_ key. The application also accepts
# legacy SUPABASE_SERVICE_ROLE_KEY during migration. Never use NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=your-secret-key

# Public Cloudflare Turnstile widget key
NEXT_PUBLIC_TURNSTILE_SITE_KEY=your-turnstile-site-key

# Server-only Cloudflare Turnstile secret; never prefix this with NEXT_PUBLIC_
TURNSTILE_SECRET_KEY=your-turnstile-secret-key

# Server-only emergency upload kill switch. Production must opt in explicitly.
UPLOADS_ENABLED=false
